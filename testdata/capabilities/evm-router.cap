# Routes this surface can carry, as protocol slugs.
route cctp
route axelar-its

# Entry points that attach a provider payment.
paid-method bridgeOut
paid-method bridgeOutBounded
paid-method bridgeOutWithIntent
paid-method bridgeOutWithPermit
paid-method bridgeOutWithRefundCredit
paid-method bridgeOutWithRelayerFee
